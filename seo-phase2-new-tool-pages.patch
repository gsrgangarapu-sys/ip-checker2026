--- /dev/null
+++ b/src/routes/dns-propagation-checker.tsx
@@ -0,0 +1,288 @@
+import { createFileRoute, Link } from "@tanstack/react-router";
+import { Seo } from "@/components/Seo";
+import { useState } from "react";
+import { motion, AnimatePresence } from "framer-motion";
+import { SiteHeader } from "@/components/SiteHeader";
+import { SiteFooter } from "@/components/SiteFooter";
+import type { DnsAnswer, DnsType } from "@/lib/dns";
+import { Globe, Loader2, ArrowRight, CheckCircle2, XCircle, AlertCircle, Terminal } from "lucide-react";
+
+export const Route = createFileRoute("/dns-propagation-checker")({
+  head: () => ({
+    meta: [
+      { title: "DNS Propagation Checker — Check DNS Propagation Worldwide | DNSChecker" },
+      { name: "description", content: "Free DNS propagation checker. Verify whether DNS record changes have propagated worldwide by querying Cloudflare, Google, Quad9, AdGuard, OpenDNS and CleanBrowsing resolvers in real time." },
+      { property: "og:title", content: "DNS Propagation Checker — Check DNS Propagation Worldwide" },
+      { property: "og:description", content: "See if your DNS changes have propagated across global resolvers. Free, instant, no sign-up." },
+      { property: "og:url", content: "https://www.dnschecker.space/dns-propagation-checker" },
+    ],
+    links: [{ rel: "canonical", href: "https://www.dnschecker.space/dns-propagation-checker" }],
+  }),
+  component: PropagationPage,
+});
+
+const TYPES: DnsType[] = ["A", "AAAA", "MX", "NS", "TXT", "CNAME", "SOA", "CAA"];
+
+interface Resolver {
+  name: string;
+  region: string;
+  url: string;
+}
+
+const RESOLVERS: Resolver[] = [
+  { name: "Cloudflare", region: "Global (Anycast)", url: "https://cloudflare-dns.com/dns-query" },
+  { name: "Google", region: "Global (Anycast)", url: "https://dns.google/resolve" },
+  { name: "Quad9", region: "Global (Anycast)", url: "https://dns.quad9.net/dns-query" },
+  { name: "AdGuard", region: "Europe", url: "https://dns.adguard-dns.com/dns-query" },
+  { name: "OpenDNS (Cisco)", region: "United States", url: "https://doh.opendns.com/dns-query" },
+  { name: "CleanBrowsing", region: "United States", url: "https://doh.cleanbrowsing.org/doh/security-filter/" },
+];
+
+interface ResolverResult {
+  resolver: Resolver;
+  status: "ok" | "empty" | "error";
+  values: string[];
+  ttl: number | null;
+}
+
+async function queryResolver(r: Resolver, name: string, type: DnsType): Promise<ResolverResult> {
+  try {
+    const res = await fetch(`${r.url}?name=${encodeURIComponent(name)}&type=${type}`, {
+      headers: { Accept: "application/dns-json" },
+    });
+    if (!res.ok) throw new Error(String(res.status));
+    const data = await res.json();
+    const answers = (data.Answer ?? []) as DnsAnswer[];
+    return {
+      resolver: r,
+      status: answers.length ? "ok" : "empty",
+      values: answers.map((a) => a.data).sort(),
+      ttl: answers.length ? answers[0].TTL : null,
+    };
+  } catch {
+    return { resolver: r, status: "error", values: [], ttl: null };
+  }
+}
+
+const FAQS = [
+  {
+    question: "What is DNS propagation?",
+    answer:
+      "DNS propagation is the period after you change a DNS record while resolvers around the world update their caches. Each record has a TTL (time to live); until a resolver's cached copy expires, it keeps answering with the old value. That is why a change can be visible in one country and not another for a while.",
+  },
+  {
+    question: "How long does DNS propagation take?",
+    answer:
+      "Most changes propagate within a few minutes to a few hours. The worst case is set by the record's old TTL — a record cached with a 48-hour TTL can take up to 48 hours to fully refresh everywhere, although modern resolvers usually update much sooner.",
+  },
+  {
+    question: "How can I speed up DNS propagation?",
+    answer:
+      "Lower the TTL on the record to 300 seconds at least one full old-TTL period before making the change, make the change, wait for caches to expire, then raise the TTL again. You cannot force other networks' caches to clear, but planning the TTL drop removes most of the wait.",
+  },
+  {
+    question: "Why do different resolvers show different results?",
+    answer:
+      "Each resolver caches answers independently and refreshes on its own schedule. During propagation it is normal for Cloudflare to show the new value while another resolver still serves the cached old one. When every resolver here agrees, propagation is complete.",
+  },
+  {
+    question: "Which record types can I check propagation for?",
+    answer:
+      "This tool checks A, AAAA, MX, NS, TXT, CNAME, SOA and CAA records — the types used for websites, email delivery, domain verification and certificate issuance.",
+  },
+];
+
+function PropagationPage() {
+  const [name, setName] = useState("");
+  const [type, setType] = useState<DnsType>("A");
+  const [loading, setLoading] = useState(false);
+  const [results, setResults] = useState<ResolverResult[] | null>(null);
+
+  const submit = async (e: React.FormEvent) => {
+    e.preventDefault();
+    let v = name.trim();
+    if (!v) return;
+    try {
+      if (v.startsWith("http")) v = new URL(v).hostname;
+      else if (v.includes("/")) v = v.split("/")[0];
+    } catch {
+      v = v.replace(/^https?:\/\//, "").split("/")[0];
+    }
+    setLoading(true);
+    setResults(null);
+    const out = await Promise.all(RESOLVERS.map((r) => queryResolver(r, v, type)));
+    setResults(out);
+    setLoading(false);
+  };
+
+  const answered = results?.filter((r) => r.status === "ok") ?? [];
+  const groups = new Map<string, number>();
+  answered.forEach((r) => {
+    const key = r.values.join(" | ");
+    groups.set(key, (groups.get(key) ?? 0) + 1);
+  });
+  const topCount = groups.size ? Math.max(...groups.values()) : 0;
