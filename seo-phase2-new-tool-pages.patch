+      if (v.startsWith("http")) v = new URL(v).hostname;
+      else if (v.includes("/")) v = v.split("/")[0];
+      if (v.includes("@")) v = v.split("@").pop() ?? v;
+    } catch {
+      v = v.replace(/^https?:\/\//, "").split("/")[0];
+    }
+    setLoading(true);
+    setError(null);
+    setResult(null);
+    try {
+      const data = await dohQuery(v, "TXT");
+      const spfs = data
+        .map((a) => a.data.replace(/"/g, ""))
+        .filter((t) => t.toLowerCase().startsWith("v=spf1"));
+      setResult({ found: spfs.map(analyzeSpf), multiple: spfs.length > 1 });
+    } catch (err) {
+      setError(err instanceof Error ? err.message : "Lookup failed");
+    } finally {
+      setLoading(false);
+    }
+  };
+
+  return (
