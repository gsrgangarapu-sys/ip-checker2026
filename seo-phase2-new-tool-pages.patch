+                      receiving servers have no way to verify legitimate senders. Add a TXT record starting with{" "}
+                      <span className="font-mono">v=spf1</span> listing your mail services, ending with{" "}
+                      <span className="font-mono">-all</span>.
+                    </p>
+                  </div>
+                </div>
+              )}
+              {result.multiple && (
+                <div className="bg-amber-50 border border-amber-200 rounded-2xl p-5 flex items-start gap-3">
+                  <AlertTriangle className="h-5 w-5 text-amber-600 mt-0.5" />
+                  <p className="text-sm text-amber-800">
+                    <strong>Multiple SPF records found.</strong> A domain may publish only one — with two or more,
+                    SPF fails (PermError) for every message. Merge them into a single record.
+                  </p>
+                </div>
+              )}
+              {result.found.map((a, i) => (
+                <div key={i} className="bg-white shadow-lg rounded-[32px] p-10 border border-slate-200">
+                  <div className="flex items-center gap-2 mb-6">
+                    {a.problems.length === 0 ? (
+                      <CheckCircle2 className="h-5 w-5 text-emerald-500" />
+                    ) : (
+                      <AlertTriangle className="h-5 w-5 text-amber-500" />
+                    )}
+                    <h2 className="text-sm font-bold uppercase tracking-[0.2em] text-foreground">
+                      {a.problems.length === 0 ? "SPF record looks healthy" : "SPF record found — with warnings"}
+                    </h2>
+                  </div>
+                  <p className="font-mono text-sm bg-slate-50 border border-slate-200 rounded-xl p-4 break-all mb-6">{a.record}</p>
+                  <div className="grid sm:grid-cols-3 gap-4 mb-6 text-sm">
+                    <div className="p-4 rounded-xl bg-slate-50 border border-slate-200">
+                      <span className="block text-[10px] font-bold uppercase tracking-widest text-secondary-foreground/50 mb-1">Mechanisms</span>
+                      <span className="font-bold text-foreground">{a.mechanisms.length}</span>
+                    </div>
+                    <div className="p-4 rounded-xl bg-slate-50 border border-slate-200">
+                      <span className="block text-[10px] font-bold uppercase tracking-widest text-secondary-foreground/50 mb-1">DNS Lookups (est.)</span>
+                      <span className="font-bold text-foreground">{a.lookupCount} / 10</span>
+                    </div>
+                    <div className="p-4 rounded-xl bg-slate-50 border border-slate-200">
+                      <span className="block text-[10px] font-bold uppercase tracking-widest text-secondary-foreground/50 mb-1">Default Policy</span>
