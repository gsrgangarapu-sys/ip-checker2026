+import { SiteFooter } from "@/components/SiteFooter";
+import { dohQuery } from "@/lib/dns";
+import { ShieldCheck, Loader2, ArrowRight, CheckCircle2, XCircle, AlertTriangle, Terminal } from "lucide-react";
+
+export const Route = createFileRoute("/spf-checker")({
+  head: () => ({
+    meta: [
+      { title: "SPF Checker — Check SPF Record for Any Domain | DNSChecker" },
+      { name: "description", content: "Free SPF checker. Look up and validate the SPF record of any domain — mechanisms, include lookups, and the 10-DNS-lookup limit — to stop email spoofing and spam-folder delivery." },
+      { property: "og:title", content: "SPF Checker — Check SPF Record for Any Domain" },
+      { property: "og:description", content: "Validate SPF records instantly: mechanisms, includes, lookup count and common errors. Free." },
+      { property: "og:url", content: "https://www.dnschecker.space/spf-checker" },
+    ],
+    links: [{ rel: "canonical", href: "https://www.dnschecker.space/spf-checker" }],
+  }),
+  component: SpfPage,
+});
+
+interface SpfAnalysis {
+  record: string;
+  mechanisms: string[];
+  lookupCount: number;
+  allPolicy: string | null;
+  problems: string[];
+}
+
+function analyzeSpf(record: string): SpfAnalysis {
+  const tokens = record.split(/\s+/).filter(Boolean);
+  const mechanisms = tokens.slice(1);
+  const lookupTerms = ["include:", "a", "mx", "ptr", "exists:", "redirect="];
+  let lookupCount = 0;
+  mechanisms.forEach((m) => {
+    const base = m.replace(/^[+\-~?]/, "");
+    if (lookupTerms.some((t) => base === t || base.startsWith(t))) lookupCount++;
+  });
+  const allTerm = mechanisms.find((m) => /[+\-~?]all$/.test(m)) ?? null;
+  const problems: string[] = [];
+  if (lookupCount > 10) problems.push(`Uses about ${lookupCount} DNS lookups — SPF fails permanently (PermError) above 10.`);
+  if (!allTerm) problems.push("No 'all' mechanism found — the record does not state what to do with unauthorised senders.");
+  if (allTerm && allTerm.startsWith("+")) problems.push("'+all' authorises every server on the internet to send as your domain. Use -all or ~all instead.");
+  if (mechanisms.some((m) => m.replace(/^[+\-~?]/, "") === "ptr")) problems.push("Uses the deprecated 'ptr' mechanism, which is slow and unreliable.");
+  return { record, mechanisms, lookupCount, allPolicy: allTerm, problems };
+}
+
+const FAQS = [
+  {
+    question: "What is an SPF record?",
+    answer:
+      "SPF (Sender Policy Framework) is a DNS TXT record that lists which mail servers are allowed to send email for your domain. Receiving servers compare the sending server against this list; mail from unlisted servers can be rejected or sent to spam. SPF is one of the three pillars of email authentication, alongside DKIM and DMARC.",
+  },
+  {
+    question: "What does v=spf1 -all mean?",
+    answer:
+      "v=spf1 declares the SPF version. The mechanisms before 'all' list authorised senders (for example include:_spf.google.com). '-all' is a hard fail: anything not listed is unauthorised. '~all' is a soft fail, treated as suspicious but not conclusive. A well-configured domain should end in -all once every legitimate sender is included.",
+  },
+  {
+    question: "What is the SPF 10-lookup limit?",
+    answer:
+      "An SPF evaluation may trigger at most 10 DNS lookups (from include, a, mx, ptr, exists and redirect terms, including nested ones). Exceeding the limit causes a permanent error (PermError) and SPF fails for every message — a very common cause of 'SPF is set up but mail still fails'. Flattening includes or removing unused services fixes it.",
+  },
+  {
+    question: "Can a domain have two SPF records?",
+    answer:
+      "No. A domain must publish exactly one SPF record. Two v=spf1 TXT records make SPF fail with PermError. When you add a new sending service, merge its include into the existing record instead of adding a second one.",
+  },
+  {
+    question: "How do I create an SPF record?",
+    answer:
+      "List every service that sends mail as your domain: your mail host (for example include:_spf.google.com for Google Workspace or include:spf.protection.outlook.com for Microsoft 365), your website server (ip4:203.0.113.10), and any marketing or helpdesk tools. Combine them in one TXT record ending with -all, then verify it here.",
+  },
+];
+
+function SpfPage() {
+  const [name, setName] = useState("");
+  const [loading, setLoading] = useState(false);
+  const [error, setError] = useState<string | null>(null);
