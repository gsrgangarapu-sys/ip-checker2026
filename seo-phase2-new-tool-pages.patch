+            <div className="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-100 border border-emerald-200 mb-6">
+              <ShieldCheck className="h-3 w-3 text-emerald-600" />
+              <span className="text-[10px] font-bold uppercase tracking-widest text-emerald-600">Email Authentication</span>
+            </div>
+            <h1 className="text-4xl sm:text-6xl font-black text-foreground mb-6 tracking-tight">
+              SPF <span className="text-gradient">Checker</span>
+            </h1>
+            <p className="text-lg text-secondary-foreground max-w-2xl leading-relaxed mb-12">
+              Check the SPF record of any domain and validate it on the spot — mechanisms, authorised senders,
+              lookup count against the 10-lookup limit, and the mistakes that quietly break email delivery.
+            </p>
+
+            <form onSubmit={submit} className="relative max-w-3xl group">
+              <div className="absolute -inset-1 bg-gradient-to-r from-emerald-500 to-teal-400 rounded-[24px] blur opacity-25 group-hover:opacity-40 transition duration-1000" />
+              <div className="relative flex items-center bg-white border border-slate-200 shadow-sm rounded-[20px] p-2 overflow-hidden">
+                <div className="flex flex-1 items-center pl-4 w-full">
+                  <ShieldCheck className="h-5 w-5 text-secondary-foreground/40 mr-4" />
+                  <input
+                    value={name}
+                    onChange={(e) => setName(e.target.value)}
+                    placeholder="e.g. google.com"
+                    className="flex-1 bg-transparent border-none outline-none text-foreground placeholder:text-secondary-foreground/30 font-mono text-base py-3"
+                  />
+                </div>
+                <button
+                  type="submit"
+                  disabled={loading}
+                  className="bg-gradient-to-r from-emerald-500 to-teal-500 hover:scale-105 active:scale-95 text-white px-8 py-3.5 rounded-[16px] font-black text-sm transition-all shadow-md flex items-center justify-center gap-2 disabled:opacity-50"
+                >
+                  {loading ? <Loader2 className="h-4 w-4 animate-spin" /> : "Check SPF"}
+                  {!loading && <ArrowRight className="h-4 w-4" />}
+                </button>
+              </div>
+            </form>
+          </motion.div>
+        </div>
+      </section>
+
+      <section className="mx-auto w-full max-w-7xl px-4 sm:px-6 py-12 flex-1">
+        <AnimatePresence mode="wait">
+          {error && (
+            <motion.div initial={{ opacity: 0, scale: 0.95 }} animate={{ opacity: 1, scale: 1 }} className="glass rounded-2xl p-6 border-danger/20 bg-danger/5 text-danger font-mono text-sm flex items-center gap-3">
+              <Terminal className="h-5 w-5" />
+              {error}
+            </motion.div>
+          )}
+          {result && (
+            <motion.div initial={{ opacity: 0, y: 20 }} animate={{ opacity: 1, y: 0 }} className="space-y-4">
+              {result.found.length === 0 && (
