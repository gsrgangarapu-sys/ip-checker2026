+              <Mail className="h-3 w-3 text-emerald-600" />
+              <span className="text-[10px] font-bold uppercase tracking-widest text-emerald-600">Mail Exchange Lookup</span>
+            </div>
+            <h1 className="text-4xl sm:text-6xl font-black text-foreground mb-6 tracking-tight">
+              MX <span className="text-gradient">Lookup</span>
+            </h1>
+            <p className="text-lg text-secondary-foreground max-w-2xl leading-relaxed mb-12">
+              Find out where email for a domain is delivered. This MX lookup returns every mail exchange record,
+              sorted by priority, so you can verify a new mail service or diagnose why messages are not arriving.
+            </p>
+
+            <form onSubmit={submit} className="relative max-w-3xl group">
+              <div className="absolute -inset-1 bg-gradient-to-r from-emerald-500 to-teal-400 rounded-[24px] blur opacity-25 group-hover:opacity-40 transition duration-1000" />
+              <div className="relative flex items-center bg-white border border-slate-200 shadow-sm rounded-[20px] p-2 overflow-hidden">
+                <div className="flex flex-1 items-center pl-4 w-full">
+                  <Mail className="h-5 w-5 text-secondary-foreground/40 mr-4" />
+                  <input
+                    value={name}
+                    onChange={(e) => setName(e.target.value)}
+                    placeholder="e.g. gmail.com or you@company.com"
+                    className="flex-1 bg-transparent border-none outline-none text-foreground placeholder:text-secondary-foreground/30 font-mono text-base py-3"
+                  />
+                </div>
+                <button
+                  type="submit"
+                  disabled={loading}
+                  className="bg-gradient-to-r from-emerald-500 to-teal-500 hover:scale-105 active:scale-95 text-white px-8 py-3.5 rounded-[16px] font-black text-sm transition-all shadow-md flex items-center justify-center gap-2 disabled:opacity-50"
+                >
+                  {loading ? <Loader2 className="h-4 w-4 animate-spin" /> : "Lookup"}
+                  {!loading && <ArrowRight className="h-4 w-4" />}
+                </button>
+              </div>
+            </form>
+          </motion.div>
+        </div>
+      </section>
+
+      <section className="mx-auto w-full max-w-7xl px-4 sm:px-6 py-12 flex-1">
+        <AnimatePresence mode="wait">
+          {error && (
+            <motion.div initial={{ opacity: 0, scale: 0.95 }} animate={{ opacity: 1, scale: 1 }} className="glass rounded-2xl p-6 border-danger/20 bg-danger/5 text-danger font-mono text-sm flex items-center gap-3">
+              <Terminal className="h-5 w-5" />
+              {error}
+            </motion.div>
+          )}
+          {records && (
+            <motion.div initial={{ opacity: 0, y: 20 }} animate={{ opacity: 1, y: 0 }} className="bg-white shadow-lg rounded-[32px] p-10 border border-slate-200 overflow-hidden">
+              <div className="flex items-center gap-2 mb-8">
+                <Terminal className="h-5 w-5 text-emerald-600" />
+                <h2 className="text-sm font-bold uppercase tracking-[0.2em] text-foreground">
+                  {records.length} MX Record{records.length === 1 ? "" : "s"} Found
+                </h2>
+              </div>
+              {records.length === 0 ? (
+                <div className="flex items-start gap-3 text-amber-600">
+                  <AlertCircle className="h-5 w-5 mt-0.5" />
+                  <p className="text-sm leading-relaxed">
+                    This domain publishes <strong>no MX records</strong> — it cannot receive email. If you just
+                    added MX records, they may still be propagating; verify with the{" "}
+                    <Link to="/dns-propagation-checker" className="underline font-semibold">DNS Propagation Checker</Link>.
+                  </p>
+                </div>
+              ) : (
+                <div className="overflow-x-auto custom-scrollbar">
+                  <table className="w-full text-left">
+                    <thead>
+                      <tr className="text-[10px] font-bold uppercase tracking-[0.2em] text-secondary-foreground/40 border-b border-slate-200">
+                        <th className="pb-4 pr-6">Priority</th>
