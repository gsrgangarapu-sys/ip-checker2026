+      { property: "og:title", content: "MX Lookup — Check MX Records for Any Domain" },
+      { property: "og:description", content: "Instant MX record lookup with priorities and mail-server analysis. Free, no sign-up." },
+      { property: "og:url", content: "https://www.dnschecker.space/mx-lookup" },
+    ],
+    links: [{ rel: "canonical", href: "https://www.dnschecker.space/mx-lookup" }],
+  }),
+  component: MxPage,
+});
+
+interface MxRecord {
+  priority: number;
+  host: string;
+  ttl: number;
+}
+
+const FAQS = [
+  {
+    question: "What is an MX record?",
+    answer:
+      "An MX (Mail Exchange) record tells sending mail servers where to deliver email for a domain. Each MX record points to a mail server hostname and carries a priority number. Without at least one valid MX record, a domain cannot receive email.",
+  },
+  {
+    question: "What does MX priority mean?",
+    answer:
+      "Lower numbers are tried first. If your records are 10 and 20, senders deliver to the priority-10 server and only fall back to priority-20 if the first is unreachable. Equal priorities share the load between servers.",
+  },
+  {
+    question: "Why is my email not arriving?",
+    answer:
+      "Common causes: missing or recently changed MX records that have not propagated yet, MX records pointing to a hostname with no A record, or a mail host that is down. Run this lookup, then check propagation with the DNS Propagation Checker, and verify SPF, DKIM and DMARC so receiving servers do not reject or spam-folder your mail.",
+  },
+  {
+    question: "What are Google Workspace and Microsoft 365 MX records?",
+    answer:
+      "Google Workspace uses smtp.google.com (priority 1) for newer setups, or the five aspmx.l.google.com / alt*.aspmx.l.google.com hosts. Microsoft 365 uses a single MX host shaped like your-domain.mail.protection.outlook.com. If these are missing after you connect a mail service, email will not be delivered.",
+  },
+  {
+    question: "Can an MX record point to an IP address or CNAME?",
+    answer:
+      "No. An MX record must point to a hostname that has an A or AAAA record. Pointing MX at an IP address or at a CNAME is invalid and some senders will refuse delivery.",
+  },
+];
+
+function MxPage() {
+  const [name, setName] = useState("");
+  const [loading, setLoading] = useState(false);
+  const [error, setError] = useState<string | null>(null);
