+import { createFileRoute, Link } from "@tanstack/react-router";
+import { Seo } from "@/components/Seo";
+import { SiteHeader } from "@/components/SiteHeader";
+import { SiteFooter } from "@/components/SiteFooter";
+import { Globe, ShieldCheck, Zap, Lock } from "lucide-react";
+
+export const Route = createFileRoute("/about")({
+  head: () => ({
+    meta: [
+      { title: "About DNSChecker — Free DNS, IP, WHOIS & SSL Tools" },
+      { name: "description", content: "DNSChecker (dnschecker.space) is a free network intelligence toolkit for developers, sysadmins and website owners: DNS propagation checks, IP lookup, WHOIS, SSL, MX and SPF tools — no sign-up, no tracking of your lookups." },
+      { property: "og:title", content: "About DNSChecker" },
+      { property: "og:description", content: "Free DNS, IP, WHOIS, SSL and email tools for developers and sysadmins." },
+      { property: "og:url", content: "https://www.dnschecker.space/about" },
+    ],
+    links: [{ rel: "canonical", href: "https://www.dnschecker.space/about" }],
+  }),
+  component: AboutPage,
+});
+
+const orgSchema = {
+  "@context": "https://schema.org",
+  "@type": "Organization",
+  name: "DNSChecker",
+  alternateName: ["DNS Checker", "DNSChecker Space"],
+  url: "https://www.dnschecker.space",
+  description:
+    "Free online DNS checker and network intelligence toolkit: DNS propagation, IP lookup, WHOIS, SSL, MX, SPF and security header tools.",
+};
+
+function AboutPage() {
+  return (
+    <div className="min-h-screen flex flex-col">
+      <Seo
+        title="About DNSChecker — Free DNS, IP, WHOIS & SSL Tools"
+        description="DNSChecker is a free network intelligence toolkit for developers, sysadmins and website owners."
+        url="https://www.dnschecker.space/about"
+        schema={orgSchema}
+      />
+      <SiteHeader />
+
+      <section className="mx-auto w-full max-w-4xl px-4 sm:px-6 py-16 flex-1">
+        <h1 className="text-4xl sm:text-5xl font-black text-foreground mb-6 tracking-tight">
+          About <span className="text-gradient">DNSChecker</span>
+        </h1>
+        <div className="space-y-6 text-secondary-foreground leading-relaxed">
+          <p>
+            DNSChecker (dnschecker.space) is a free network intelligence toolkit built for developers, system
+            administrators, and website owners who need fast, trustworthy answers about domains and IP addresses —
+            without creating an account or wading through ads.
+          </p>
+          <p>
+            The toolkit brings the lookups professionals run every day into one console: a{" "}
+            <Link to="/dns-propagation-checker" className="text-emerald-600 font-semibold hover:underline">DNS propagation checker</Link>{" "}
+            that polls global resolvers in real time, full{" "}
+            <Link to="/dns" className="text-emerald-600 font-semibold hover:underline">DNS record lookups</Link>,{" "}
+            <Link to="/lookup" className="text-emerald-600 font-semibold hover:underline">IP address intelligence</Link>,{" "}
+            <Link to="/whois" className="text-emerald-600 font-semibold hover:underline">WHOIS</Link>,{" "}
+            <Link to="/ssl" className="text-emerald-600 font-semibold hover:underline">SSL certificate checks</Link>,{" "}
+            <Link to="/mx-lookup" className="text-emerald-600 font-semibold hover:underline">MX</Link> and{" "}
+            <Link to="/spf-checker" className="text-emerald-600 font-semibold hover:underline">SPF</Link> email
+            diagnostics, DNS blacklist monitoring, open-port checks, security-header grading, and IP geolocation.
+          </p>
+          <h2 className="text-2xl font-black text-foreground pt-4">How it works</h2>
+          <p>
+            Lookups run over encrypted DNS-over-HTTPS (DoH) against public resolvers such as Cloudflare and
+            Google, and against live registry and certificate-transparency data. Results are computed in real
+            time for every query — nothing is copied from a stale database.
+          </p>
+          <div className="grid sm:grid-cols-3 gap-4 pt-2">
+            <div className="p-5 rounded-2xl bg-white border border-slate-200">
+              <Zap className="h-5 w-5 text-emerald-600 mb-2" />
+              <h3 className="font-bold text-foreground mb-1">Fast by design</h3>
+              <p className="text-sm">Server-rendered pages and direct resolver queries return answers in seconds.</p>
+            </div>
+            <div className="p-5 rounded-2xl bg-white border border-slate-200">
+              <Lock className="h-5 w-5 text-emerald-600 mb-2" />
+              <h3 className="font-bold text-foreground mb-1">Private</h3>
+              <p className="text-sm">No account, no sign-up, and the domains you look up are not sold or shared.</p>
+            </div>
+            <div className="p-5 rounded-2xl bg-white border border-slate-200">
+              <ShieldCheck className="h-5 w-5 text-emerald-600 mb-2" />
+              <h3 className="font-bold text-foreground mb-1">Honest data</h3>
+              <p className="text-sm">We show live results with their TTLs and sources, and say so when a record does not exist.</p>
+            </div>
+          </div>
+          <h2 className="text-2xl font-black text-foreground pt-4">Learn as you check</h2>
+          <p>
+            Every tool page explains what it checks and how to interpret the results, and our{" "}
+            <Link to="/blog" className="text-emerald-600 font-semibold hover:underline">guides and tutorials</Link>{" "}
+            go deeper — DNS propagation, email authentication (SPF, DKIM, DMARC), SSL validation, and IP
+            reputation. Start with the{" "}
+            <Link to="/tools" className="text-emerald-600 font-semibold hover:underline">full tool list</Link>{" "}
+            or run your first check from the{" "}
+            <Link to="/" className="text-emerald-600 font-semibold hover:underline">homepage console</Link>.
+          </p>
+          <p className="flex items-center gap-2 text-sm">
+            <Globe className="h-4 w-4 text-emerald-600" />
+            DNSChecker is free for personal and professional use.
+          </p>
+        </div>
+      </section>
+
+      <SiteFooter />
+    </div>
+  );
+}
