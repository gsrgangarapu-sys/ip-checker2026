+
+  const submit = async (e: React.FormEvent) => {
+    e.preventDefault();
+    let v = name.trim();
+    if (!v) return;
+    try {
+      if (v.startsWith("http")) v = new URL(v).hostname;
+      else if (v.includes("/")) v = v.split("/")[0];
+      if (v.includes("@")) v = v.split("@").pop() ?? v;
+    } catch {
+      v = v.replace(/^https?:\/\//, "").split("/")[0];
+    }
+    setLoading(true);
+    setError(null);
+    setRecords(null);
+    try {
+      const data = await dohQuery(v, "MX");
+      const parsed = data
+        .map((a) => {
+          const parts = a.data.trim().split(/\s+/);
+          return { priority: parseInt(parts[0], 10), host: parts.slice(1).join(" ").replace(/\.$/, ""), ttl: a.TTL };
+        })
+        .filter((r) => !Number.isNaN(r.priority) && r.host)
+        .sort((a, b) => a.priority - b.priority);
+      setRecords(parsed);
+    } catch (err) {
+      setError(err instanceof Error ? err.message : "Lookup failed");
+    } finally {
+      setLoading(false);
+    }
+  };
